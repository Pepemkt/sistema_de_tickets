generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum OrderKind {
  ONLINE
  MANUAL
  INVITATION
}

enum UserRole {
  ADMIN
  MANAGER
  SELLER
  SCANNER
}

enum CouponDiscountType {
  FIXED_PRICE
  FIXED_DISCOUNT
  PERCENT
}

enum EmailDeliveryStatus {
  SENT
  FAILED
}

enum TicketSaleMode {
  PUBLIC
  COUPON_ONLY
  HIDDEN
}

enum EventStatus {
  ACTIVE
  UPCOMING
  DRAFT
}

enum CommercialModel {
  GLOBAL
  DELEGATED
}

enum MerchantProvider {
  MERCADOPAGO
}

enum MerchantAccountStatus {
  ACTIVE
  DISABLED
}

enum LiquidationStatus {
  DRAFT
  FINALIZED
  SETTLED
  CANCELLED
}

model Event {
  id                 String             @id @default(cuid())
  clientId           String?
  slug               String             @unique
  name               String
  featuredTag        String?
  description        String?
  featureTags        Json?
  heroImageUrl       String?
  venue              String?
  status             EventStatus        @default(ACTIVE)
  platformCommissionRateBps Int         @default(500)
  registrationFieldsJson Json?
  startsAt           DateTime
  endsAt             DateTime?
  templateJson       Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  client             Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ticketTypes        TicketType[]
  coupons            Coupon[]
  orders             Order[]
  tickets            Ticket[]
  managerAssignments EventManagerScope[]
  emailDeliveries    EmailDeliveryLog[]
  liquidations       Liquidation[]

  @@index([clientId])
}

model TicketType {
  id          String         @id @default(cuid())
  eventId     String
  name        String
  priceCents  Int
  stock       Int
  saleMode    TicketSaleMode @default(PUBLIC)
  maxPerOrder Int?
  maxPerEmail Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  event       Event          @relation(fields: [eventId], references: [id])
  orders      Order[]
  tickets     Ticket[]
  coupons     Coupon[]
}

model Order {
  id                String             @id @default(cuid())
  eventId           String
  ticketTypeId      String
  clientId          String?
  merchantAccountId String?
  kind              OrderKind          @default(ONLINE)
  commercialModel   CommercialModel    @default(GLOBAL)
  platformCommissionRateBps Int        @default(500)
  quantity          Int
  totalCents        Int
  subtotalCents     Int                @default(0)
  discountCents     Int                @default(0)
  buyerName         String
  buyerEmail        String
  buyerPhone        String?
  registrationAnswersJson Json?
  couponId          String?
  status            OrderStatus        @default(PENDING)
  mercadoPagoRef    String?
  mercadoPagoInit   String?
  mercadoPagoPay    String?
  merchantSnapshot  Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  event             Event              @relation(fields: [eventId], references: [id])
  ticketType        TicketType         @relation(fields: [ticketTypeId], references: [id])
  coupon            Coupon?            @relation(fields: [couponId], references: [id])
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  merchantAccount   MerchantAccount?   @relation(fields: [merchantAccountId], references: [id], onDelete: SetNull)
  tickets           Ticket[]
  emailDeliveries   EmailDeliveryLog[]
  payments          Payment[]
  liquidationItems  LiquidationItem[]

  @@index([clientId])
  @@index([merchantAccountId])
  @@index([commercialModel])
}

model Client {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           Event[]
  merchantAccounts MerchantAccount[]
  orders           Order[]
  liquidations     Liquidation[]
}

model MerchantAccount {
  id                String                @id @default(cuid())
  clientId          String
  provider          MerchantProvider      @default(MERCADOPAGO)
  accessToken       String
  webhookSecret     String?
  status            MerchantAccountStatus @default(ACTIVE)
  commissionRateBps Int                   @default(500)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders            Order[]
  liquidations      Liquidation[]

  @@unique([clientId, provider])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  provider          String   @default("MERCADOPAGO")
  providerPaymentId String   @unique
  status            String
  source            String
  merchantSnapshot  Json?
  rawPayload        Json?
  approvedAt        DateTime?
  ticketEmailSentAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  liquidationItems  LiquidationItem[]

  @@index([orderId])
  @@index([status])
}

model Liquidation {
  id                        String            @id @default(cuid())
  clientId                  String
  eventId                   String
  merchantAccountId         String?
  status                    LiquidationStatus @default(DRAFT)
  grossCents                Int
  commissionCents           Int
  netCents                  Int
  commissionRateBpsSnapshot Int
  periodStartsAt            DateTime?
  periodEndsAt              DateTime?
  settledAt                 DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  client                    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event                     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  merchantAccount           MerchantAccount?  @relation(fields: [merchantAccountId], references: [id], onDelete: SetNull)
  items                     LiquidationItem[]

  @@index([clientId, status])
  @@index([eventId, status])
  @@index([merchantAccountId])
}

model LiquidationItem {
  id              String      @id @default(cuid())
  liquidationId   String
  orderId         String
  paymentId       String?
  grossCents      Int
  commissionCents Int
  netCents        Int
  createdAt       DateTime    @default(now())
  liquidation     Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment         Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([liquidationId, orderId])
  @@index([orderId])
  @@index([paymentId])
}

model Coupon {
  id           String              @id @default(cuid())
  code         String              @unique
  eventId      String
  ticketTypeId String?
  maxUses      Int
  usedCount    Int                 @default(0)
  isActive     Boolean             @default(true)
  expiresAt    DateTime?
  discountType CouponDiscountType?
  discountValue Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  event        Event               @relation(fields: [eventId], references: [id])
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])
  orders       Order[]

  @@index([eventId, ticketTypeId])
}

model Ticket {
  id            String     @id @default(cuid())
  code          String     @unique
  qrPayload     String
  attendeeName  String
  attendeeEmail String
  eventId       String
  ticketTypeId  String
  orderId       String
  attendedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  event         Event      @relation(fields: [eventId], references: [id])
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id])
  order         Order      @relation(fields: [orderId], references: [id])
}

model User {
  id               String              @id @default(cuid())
  username         String              @unique
  displayName      String?
  passwordHash     String
  role             UserRole            @default(SCANNER)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         Session[]
  managedEventRefs EventManagerScope[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EventManagerScope {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model EmailDeliveryLog {
  id                String              @id @default(cuid())
  orderId           String
  eventId           String
  recipientEmail    String
  status            EmailDeliveryStatus
  trigger           String
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([orderId, createdAt])
}

model PageView {
  id           String   @id @default(cuid())
  sessionId    String   // Anonymous browser session ID (sessionStorage)
  step         String   // Public journey step or checkout interaction
  eventSlug    String   // Slug of the visited event
  pathname     String?
  referrerHost String?
  deviceType   String?
  createdAt    DateTime @default(now())

  @@index([eventSlug, step, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model PlatformConfig {
  id                       String   @id @default("default")
  mercadoPagoAccessToken   String?
  mercadoPagoWebhookSecret String?
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPass                 String?
  smtpFrom                 String?
  smtpSecure               Boolean?
  emailTemplateBuilder     Json?
  checkoutFeeItems         Json?
  emailTemplateSubject     String?
  emailTemplateHtml        String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
